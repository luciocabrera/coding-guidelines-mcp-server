{
  "name": "coding-guidelines-mcp-server",
  "description": "MCP server for coding guidelines, standards, and code generation",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "coding-guidelines-mcp": "./build/index.js"
  },
  "scripts": {
    "build:eslint-rules": "tsc -p eslint-local-rules/tsconfig.json",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build": "npm run build:eslint-rules && npm run build:mcp",
    "dev": "node build/index.js",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint:check && npm run format:check && npm run typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "coding-guidelines",
    "code-generation",
    "react",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3",
    "eslint-plugin-unicorn": "^62.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0"
  },
  "files": [
    "build",
    "guidelines",
    "LICENSE",
    "README.md"
  ]
}

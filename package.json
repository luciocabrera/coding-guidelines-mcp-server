{
  "name": "coding-guidelines-agent",
  "displayName": "Coding Guidelines Agent",
  "description": "VS Code Chat Agent with MCP server for coding guidelines",
  "version": "1.0.0",
  "publisher": "coding-guidelines",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "coding-guidelines.agent",
        "name": "guidelines",
        "fullName": "Coding Guidelines",
        "description": "Guideline-aware agent: search/validate/summarize, generate components/features, bootstrap React 19+TS+StyleX projects, run lint/typecheck/test",
        "isSticky": true,
        "commands": [
          {
            "name": "search",
            "description": "Search for specific guidelines or patterns"
          },
          {
            "name": "validate",
            "description": "Validate code against guidelines"
          },
          {
            "name": "summary",
            "description": "Get summary of a guideline document"
          }
        ]
      },
      {
        "id": "coding-guidelines.guardian",
        "name": "guardian",
        "fullName": "Enterprise Code Guardian",
        "description": "Standards enforcer: uses MCP tools to search/summarize/validate guidelines and generate standard-compliant code",
        "isSticky": true,
        "commands": [
          {
            "name": "search",
            "description": "Search for specific guidelines or patterns"
          },
          {
            "name": "validate",
            "description": "Validate code against guidelines"
          },
          {
            "name": "summary",
            "description": "Get summary of a guideline document"
          }
        ]
      },
      {
        "id": "coding-guidelines.coding",
        "name": "coding",
        "fullName": "Coding Guidelines (Alias)",
        "description": "Alias for @guidelines/@guardian",
        "isSticky": true,
        "commands": [
          {
            "name": "search",
            "description": "Search for specific guidelines or patterns"
          },
          {
            "name": "validate",
            "description": "Validate code against guidelines"
          },
          {
            "name": "summary",
            "description": "Get summary of a guideline document"
          }
        ]
      },
      {
        "id": "coding-guidelines.standards",
        "name": "standards",
        "fullName": "Coding Standards (Alias)",
        "description": "Alias for @guardian (standards-focused persona)",
        "isSticky": true,
        "commands": [
          {
            "name": "search",
            "description": "Search for specific guidelines or patterns"
          },
          {
            "name": "validate",
            "description": "Validate code against guidelines"
          },
          {
            "name": "summary",
            "description": "Get summary of a guideline document"
          }
        ]
      }
    ]
  },
  "scripts": {
    "build:mcp": "node scripts/build-mcp.mjs",
    "build:extension": "tsc -p src/extension/tsconfig.json",
    "build": "npm run build:mcp && npm run build:extension",
    "watch": "tsc -p src/extension/tsconfig.json --watch",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --allow-missing-repository",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint:check && npm run format:check && npm run typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "chat",
    "coding-guidelines",
    "agent",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.1",
    "@types/vscode": "^1.107.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0"
  },
  "files": [
    "out",
    "build",
    "guidelines",
    "LICENSE"
  ]
}

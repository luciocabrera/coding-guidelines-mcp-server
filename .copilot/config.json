{
  "$schema": "https://aka.ms/copilot-workspace-config-schema",
  "version": "1.0",
  "agents": {
    "enterprise-code-guardian": {
      "enabled": true,
      "name": "Enterprise Code Guardian",
      "description": "Enforces enterprise coding standards for React 19, TypeScript, and StyleX",
      "instructionsFile": ".copilot/instructions.md",
      "triggerPhrases": ["@guardian", "@enforce", "@standards", "@review-code"],
      "capabilities": {
        "codeGeneration": true,
        "codeReview": true,
        "refactoring": true,
        "documentation": true,
        "testing": true
      },
      "filePatterns": ["**/*.ts", "**/*.tsx", "**/*.test.ts", "**/*.test.tsx"],
      "excludePatterns": ["**/node_modules/**", "**/dist/**", "**/build/**", "**/*.min.js"],
      "context": {
        "alwaysInclude": [
          ".copilot/instructions.md",
          ".copilot/examples.md",
          "tsconfig.json",
          "eslint.config.js"
        ],
        "maxContextFiles": 10,
        "maxContextLines": 5000
      },
      "validation": {
        "preCommit": true,
        "prReview": true,
        "realTime": true
      }
    }
  },
  "globalSettings": {
    "strictMode": true,
    "autoFix": false,
    "suggestionsMode": "inline"
  }
}
